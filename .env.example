# Variaveis lidas pelo Docker Compose (arquivo .env na raiz, nunca versionado).
# Copie para .env e substitua os valores. O backend deve usar as MESMAS
# credenciais em backend/.env (PG_USER, PG_PASSWORD, PG_DATABASE, PG_PORT).
POSTGRES_DB=rhcorp
POSTGRES_USER=rhcorp_app
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Porta publicada no host (padrao 5432). Deve coincidir com PG_PORT do backend.
RHCORP_POSTGRES_PORT=5432
