PORT=3333
DOTENV_CONFIG_QUIET=true
JWT_SECRET=troque-este-segredo
JWT_ISSUER=rhcorp-api
JWT_AUDIENCE=rhcorp-web
JWT_ACCESS_TTL=10m
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
TRUST_PROXY_HOPS=0
# Observabilidade: producao usa JSON; desenvolvimento usa formato legivel.
LOG_LEVEL=info
ERROR_TRACKING_DSN=
ERROR_TRACKING_TRACES_SAMPLE_RATE=0
# Mantenha desligado ate configurar o scrape autenticado pela rede interna.
METRICS_ENABLED=false
METRICS_TOKEN=

# Postgres e o padrao local. Para MySQL, use DB_CLIENT=mysql e preencha MYSQL_*.
DB_CLIENT=postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=troque-esta-senha
PG_DATABASE=rhcorp
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000
PG_APPLICATION_NAME=rhcorp-api
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
# PG_SSL_CA_BASE64=

SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=troque-por-uma-senha-de-bootstrap-com-12-ou-mais-caracteres

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=
SIGNATURE_PIN_SECRET=troque-este-segredo-de-pin
SECURE_STORAGE_PATH=./storage

# Assinatura documental e de ponto. Em desenvolvimento/teste, a assinatura e
# deterministica, mas NAO tem validade ICP-Brasil. Em producao, use um segredo
# do orquestrador para a senha e monte o certificado A1 sem inclui-lo na imagem.
ICP_BRASIL_MODE=simulado
ICP_BRASIL_SIGNER=p12
# ICP_BRASIL_P12_PATH=/run/secrets/rhcorp-certificado.pfx
# ICP_BRASIL_P12_PASSWORD=
# Para A3/HSM, selecione pkcs11 somente depois de instalar/configurar um adapter
# PKCS#11 especifico do dispositivo; sem adapter o sistema falha fechado.
# ICP_BRASIL_SIGNATURE_LENGTH=16384

# Opcional: sincroniza rooms, presenca e eventos ATS entre multiplas instancias.
REDIS_URL=redis://localhost:6379
REQUIRE_REDIS=false
# Reconhecimento facial local: em producao, configure explicitamente "local".
# Valor ausente, aws ou azure bloqueia a marcacao porque estes provedores nao estao implementados aqui.
FACIAL_MATCH_PROVIDER=
# Similaridade cosseno do embedding FaceRes; exige calibracao local antes da producao.
FACIAL_MATCH_THRESHOLD=0.82
# OCR local: obrigatorio em producao. O modo "simulado" somente e aceito fora de producao
# e sempre devolve confianca zero, exigindo revisao humana.
OCR_PROVIDER=tesseract
OCR_MANUAL_REVIEW_THRESHOLD=85
GOOGLE_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_ID=

# Segredos independentes para emissão anônima, anti-replay e isolamento do eNPS.
# Use valores aleatórios diferentes; ENPS_FEEDBACK_KEY deve ter 32 bytes em base64.
ENPS_PARTICIPATION_SECRET=
ENPS_BALLOT_SECRET=
ENPS_FINGERPRINT_SECRET=
ENPS_FEEDBACK_KEY=
# Ledger de auditoria: use segredos independentes com pelo menos 32 bytes.
AUDIT_LEDGER_SECRET=troque-por-um-segredo-hmac-forte-e-externo
AUDIT_PAYLOAD_KEY=troque-por-uma-chave-de-cifra-forte-e-independente
AUDIT_ANCHOR_PATH=./storage/audit-ledger-anchor.json
AUDIT_KEY_VERSION=1

# Uploads falham de forma fechada em producao quando este scanner nao esta configurado.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_TIMEOUT_MS=8000

# Worker idempotente de transicao APROVADA -> EM_GOZO -> ENCERRADA.
LEAVE_WORKER_INTERVAL_MS=300000
