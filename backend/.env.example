PORT=3333
JWT_SECRET=troque-este-segredo
JWT_ISSUER=rhcorp-api
JWT_AUDIENCE=rhcorp-web
JWT_ACCESS_TTL=10m
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
TRUST_PROXY_HOPS=0

# Postgres e o padrao local. Para MySQL, use DB_CLIENT=mysql e preencha MYSQL_*.
DB_CLIENT=postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=troque-esta-senha
PG_DATABASE=rhcorp
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000
PG_APPLICATION_NAME=rhcorp-api
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
# PG_SSL_CA_BASE64=

SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=troque-por-uma-senha-de-bootstrap-com-12-ou-mais-caracteres

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=
SIGNATURE_PIN_SECRET=troque-este-segredo-de-pin
SECURE_STORAGE_PATH=./storage

# Assinatura de contracheques (PAdES) e pontos (CAdES).
# Em desenvolvimento/teste, simulado e o padrao. Producao sempre exige A1 ou A3.
ICP_BRASIL_MODE=simulado
ICP_BRASIL_SIMULATION_SECRET=
ICP_BRASIL_PROVIDER=a1
ICP_BRASIL_OPENSSL_BIN=openssl
ICP_BRASIL_OPENSSL_TIMEOUT_MS=30000
ICP_BRASIL_OPENSSL_PKCS12_LEGACY=false
ICP_BRASIL_PFX_PATH=
ICP_BRASIL_PFX_PASSWORD=
ICP_BRASIL_CERT_CHAIN_PATH=
# A3/HSM: use ICP_BRASIL_PROVIDER=pkcs11 e nunca inclua pin-value na URI.
ICP_BRASIL_PKCS11_MODULE=
ICP_BRASIL_PKCS11_KEY_URI=
ICP_BRASIL_PKCS11_CERT_PATH=
ICP_BRASIL_PKCS11_PIN=
ICP_BRASIL_PKCS11_PROVIDER=pkcs11
ICP_BRASIL_PKCS11_PROVIDER_PATH=
ICP_BRASIL_PDF_SIGNATURE_LENGTH=32768
ICP_BRASIL_SIGNER_NAME=FSS RH Corporativo
ICP_BRASIL_SIGNER_CONTACT=
ICP_BRASIL_SIGNER_LOCATION=Brasil
ICP_BRASIL_SIGNATURE_REASON=Documento emitido pelo FSS RH Corporativo

# Transmissao eSocial: desligada por padrao. Quando true exige ICP_BRASIL_MODE=producao,
# XSD oficial local e todos os identificadores abaixo.
ESOCIAL_TRANSMISSION_ENABLED=false
ESOCIAL_ENVIRONMENT=restrita
ESOCIAL_EMPLOYER_TP_INSC=
ESOCIAL_EMPLOYER_NR_INSC=
ESOCIAL_TRANSMITTER_TP_INSC=
ESOCIAL_TRANSMITTER_NR_INSC=
ESOCIAL_APP_VERSION=FSS-RHCORP-1.0
ESOCIAL_XSD_DIR=
ESOCIAL_XSD_VALIDATOR_BIN=xmllint
ESOCIAL_REQUEST_TIMEOUT_MS=30000
ESOCIAL_POLLING_INTERVAL_MS=15000
# ESOCIAL_SEND_URL=
# ESOCIAL_QUERY_URL=
# A3/HSM mTLS exige ENGINE PKCS#11 instalado alem do provider de assinatura.
ESOCIAL_PKCS11_TLS_ENGINE=

# Opcional: sincroniza rooms, presenca e eventos ATS entre multiplas instancias.
REDIS_URL=redis://localhost:6379
REQUIRE_REDIS=false
GOOGLE_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_ID=

# Segredos independentes para emissão anônima, anti-replay e isolamento do eNPS.
# Use valores aleatórios diferentes; ENPS_FEEDBACK_KEY deve ter 32 bytes em base64.
ENPS_PARTICIPATION_SECRET=
ENPS_BALLOT_SECRET=
ENPS_FINGERPRINT_SECRET=
ENPS_FEEDBACK_KEY=
# Ledger de auditoria: use segredos independentes com pelo menos 32 bytes.
AUDIT_LEDGER_SECRET=troque-por-um-segredo-hmac-forte-e-externo
AUDIT_PAYLOAD_KEY=troque-por-uma-chave-de-cifra-forte-e-independente
AUDIT_ANCHOR_PATH=./storage/audit-ledger-anchor.json
AUDIT_KEY_VERSION=1

# Uploads falham de forma fechada em producao quando este scanner nao esta configurado.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_TIMEOUT_MS=8000

# Worker idempotente de transicao APROVADA -> EM_GOZO -> ENCERRADA.
LEAVE_WORKER_INTERVAL_MS=300000
