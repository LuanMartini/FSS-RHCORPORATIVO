{
  "name": "rhcorp-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.js",
    "worker": "tsx src/payroll/worker.ts",
    "worker:audit": "tsx src/audit/worker.ts",
    "worker:leave": "node src/leave/worker.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:verify": "node src/db/verify.js",
    "start": "tsx src/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"test/*.test.js\" \"test/*.test.ts\"",
    "test:coverage": "c8 --all --extension=.js --extension=.ts --include=src/** --exclude=src/db/migrations/** --exclude=src/db/schema.js --reporter=text --reporter=html --reporter=lcov --reports-dir=coverage --check-coverage --lines 42 --functions 42 --branches 62 --statements 42 node --import tsx --test \"test/*.test.js\" \"test/*.test.ts\""
  },
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tesseract.js-data/por": "1.0.0",
    "@vladmandic/human": "3.3.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fast-xml-parser": "^5.10.0",
    "helmet": "^8.3.0",
    "jpeg-js": "0.4.4",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pngjs": "7.0.0",
    "prom-client": "^15.1.3",
    "redis": "^6.2.0",
    "socket.io": "^4.8.3",
    "tesseract.js": "7.0.0",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pngjs": "6.0.5",
    "c8": "^12.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
